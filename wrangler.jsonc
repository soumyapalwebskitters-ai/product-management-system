{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "market",
  "compatibility_date": "2026-11-10",
  "main": "./worker/index.ts",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market",
      "database_id": "f5dacd2e-39db-4689-b5ec-f1d523b0bb61",
      "migrations_dir": "migrations"
    },
    {
      "binding": "REVIEWS_DB",
      "database_name": "baji-market-reviews",
      "database_id": "89aba547-ec24-4260-a721-01b53dc78c34"
    }
  ]
}
